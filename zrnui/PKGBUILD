pkgname=zrnui
pkgver=2.0.0
pkgrel=1
pkgdesc="TBD" #TODO
arch=('x86_64' 'aarch64')
url="https://github.com/Zerone-Laboratories/zrn-sdk"
license=('MIT')
depends=('freetype2' 'libpng' 'fontconfig' 'wayland' 'libxkbcommon' 'mesa' 'egl-wayland')
makedepends=('cmake' 'pkgconf')
source=()
options=('!strip')

build() {
    cmake -S "$startdir" -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DZRNUI_BUILD_SHARED=ON \
        -DZRNUI_BUILD_TESTS=OFF \
        -DZRNUI_FONT_DIR=/usr/share/fonts/zrnui/selawik \
        -DZRNUI_THEME_FILE=/usr/share/zrnui/theme/theme.ini
    cmake --build build
}

package() {
 # 1. Сначала создаем целевую директорию для библиотек
    install -d "$pkgdir/usr/lib"

    # 2. Переносим скомпилированные файлы .so
    find build -maxdepth 1 -name 'libzrnui.so*' -exec install -m755 {} "$pkgdir/usr/lib/" \;

    # 3. Копируем инклуды с явным указанием $startdir и раскрытием маски вне кавычек
    install -d "$pkgdir/usr/include"
    cp -r "$startdir"/include/* "$pkgdir/usr/include/"

    # 4. Копируем шрифты в правильную подпапку selawik
    install -d "$pkgdir/usr/share/fonts/zrnui/selawik"
    install -m644 "$startdir"/fonts/selawik/* "$pkgdir/usr/share/fonts/zrnui/selawik/"

    # 5. Копируем файл конфигурации темы из вложенной папки theme
    install -Dm644 "$startdir/theme/theme.ini" "$pkgdir/usr/share/zrnui/theme/theme.ini"
}